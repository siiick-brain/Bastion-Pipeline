# Deliberately naive single-stage image. Used only for the Trivy comparison in docs/hardening.md.
# Never deploy this image.
FROM python:3.11
WORKDIR /app
COPY app/requirements-dev.txt app/requirements.txt ./
RUN pip install -r requirements-dev.txt
COPY app/ /app/app/
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
