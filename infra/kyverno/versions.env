# Kyverno install manifest, pinned by version and SHA-256. scripts/kind-up.ps1 -WithAdmission refuses a mismatch.
# v1.19.2 signs only checksums.txt, which does not cover install.yaml; v1.20.0 and later sign install.yaml itself.
KYVERNO_VERSION=v1.19.2
KYVERNO_INSTALL_URL=https://github.com/kyverno/kyverno/releases/download/v1.19.2/install.yaml
KYVERNO_INSTALL_SHA256=4f785937dc7fe49a0731108b15def1538923c73d9236255bc69d94d498037969
