#!/usr/bin/env bash
set -eu

msg_file="${1:-}"
if [[ -z "$msg_file" || ! -f "$msg_file" ]]; then
  exit 0
fi

if grep -Eiq 'Co-authored-by:' "$msg_file"; then
  echo "Rejected: Co-authored-by trailers are not allowed." >&2
  exit 1
fi

author_name="${GIT_AUTHOR_NAME:-$(git var GIT_AUTHOR_IDENT 2>/dev/null | sed -E 's/^(.*) <.*>$/\1/' | sed 's/[[:space:]]*$//')}"
commit_name="${GIT_COMMITTER_NAME:-$(git var GIT_COMMITTER_IDENT 2>/dev/null | sed -E 's/^(.*) <.*>$/\1/' | sed 's/[[:space:]]*$//')}"
author_email="${GIT_AUTHOR_EMAIL:-$(git var GIT_AUTHOR_IDENT 2>/dev/null | sed -E 's/^.*<([^>]+)>.*$/\1/')}"
commit_email="${GIT_COMMITTER_EMAIL:-$(git var GIT_COMMITTER_IDENT 2>/dev/null | sed -E 's/^.*<([^>]+)>.*$/\1/')}"

if [[ -z "$author_name" ]]; then
  author_name="$commit_name"
fi
if [[ -z "$author_email" ]]; then
  author_email="$commit_email"
fi

if [[ "$author_name" != "siiick-brain" ]]; then
  echo "Rejected: commit author name must be siiick-brain." >&2
  exit 1
fi

if [[ "$author_email" != "devasoka38@gmail.com" ]]; then
  echo "Rejected: commit author email must be devasoka38@gmail.com." >&2
  exit 1
fi

exit 0
