#!/usr/bin/env bash
# Enforces the sole-author and Conventional Commit policy. Install: git config core.hooksPath scripts/hooks
set -euo pipefail
msg_file="${1:?commit message file required}"
# shellcheck source=scripts/lib/commit-policy.sh
source "$(git rev-parse --show-toplevel)/scripts/lib/commit-policy.sh"

ident_name() { git var "$1" | sed -E 's/^(.*) <.*$/\1/'; }
ident_email() { git var "$1" | sed -E 's/^.*<([^>]+)>.*$/\1/'; }

check_message "$msg_file"
check_identity "${GIT_AUTHOR_NAME:-$(ident_name GIT_AUTHOR_IDENT)}" "${GIT_AUTHOR_EMAIL:-$(ident_email GIT_AUTHOR_IDENT)}"
check_identity "${GIT_COMMITTER_NAME:-$(ident_name GIT_COMMITTER_IDENT)}" "${GIT_COMMITTER_EMAIL:-$(ident_email GIT_COMMITTER_IDENT)}"
